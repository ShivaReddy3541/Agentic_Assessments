# ==============================================================================
# AegisMind AI — Environment Configuration Template
# ==============================================================================

# Primary LLM Provider Configuration (Verified Default: Google Gemini)
# Supported providers: "gemini", "openai", "groq", "ollama", "mock" (offline fallback)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Multi-Provider Overrides (Uncomment to use alternative providers)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# GROQ_API_KEY=your_groq_api_key_here
# OLLAMA_BASE_URL=http://localhost:11434

# Web Search Provider Configuration
# Supported: "duckduckgo", "tavily", "mock"
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=

# Server Network Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Storage Paths
DATA_DIR=backend/data
UPLOAD_DIR=backend/data/uploads
DB_PATH=backend/data/platform.db
